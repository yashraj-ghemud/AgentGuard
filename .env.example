# Application Environment
APP_ENV=development
APP_NAME=AgentGuard
APP_VERSION=0.1.0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# Frontend Configuration
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database Configuration
DATABASE_URL=postgresql://agentguard:agentguard@localhost:5432/agentguard
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ENCRYPTION_KEY=change-this-to-a-random-32-byte-encryption-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Request Limits
MAX_REQUEST_SIZE_MB=10
MAX_RESPONSE_SIZE_MB=10
MAX_EXECUTION_TIMEOUT_SECONDS=300
REQUEST_TIMEOUT_SECONDS=30

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Security - SSRF Protection
BLOCK_PRIVATE_NETWORKS=true
BLOCK_LOCALHOST=true
BLOCK_METADATA_ENDPOINTS=true
ALLOWED_DOMAINS=

# Observability
ENABLE_METRICS=true
ENABLE_TRACING=false
TRACE_SAMPLE_RATE=0.1

# Development
DEBUG=false
RELOAD_ON_CHANGE=true

# Testing
TEST_DATABASE_URL=postgresql://agentguard:agentguard@localhost:5432/agentguard_test

# =============================================================================
# Part 2: LLM Configuration (Scenario Generation)
# =============================================================================

# LLM Provider Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_ORGANIZATION=
OPENAI_TIMEOUT_SECONDS=60

# Model Selection for Different Operations
AGENT_ANALYSIS_MODEL=gpt-4-turbo-preview
AGENT_ANALYSIS_TEMPERATURE=0.3
RISK_ANALYSIS_MODEL=gpt-4-turbo-preview
RISK_ANALYSIS_TEMPERATURE=0.2
STRATEGY_PLANNING_MODEL=gpt-4-turbo-preview
STRATEGY_PLANNING_TEMPERATURE=0.4
SCENARIO_GENERATION_MODEL=gpt-4-turbo-preview
SCENARIO_GENERATION_TEMPERATURE=0.7
SCENARIO_REVIEW_MODEL=gpt-3.5-turbo
SCENARIO_REVIEW_TEMPERATURE=0.2
MUTATION_MODEL=gpt-3.5-turbo
MUTATION_TEMPERATURE=0.8
EMBEDDING_MODEL=text-embedding-3-small

# Generation Limits
MAX_SCENARIOS_PER_REQUEST=100
MAX_GENERATION_TIMEOUT_SECONDS=3600
MAX_LLM_RETRIES=3
MAX_TOKENS_PER_REQUEST=4000

# Quality Thresholds
MIN_SCENARIO_QUALITY_SCORE=0.6
MIN_RELEVANCE_SCORE=0.7
SIMILARITY_THRESHOLD=0.85

# Cost Controls
ENABLE_COST_TRACKING=true
MAX_COST_PER_RUN=
WARN_COST_THRESHOLD=10.0
